FROM python:3.11-slim AS builder
WORKDIR /app
ENV PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential gcc && rm -rf /var/lib/apt/lists/*
COPY hlas/requirements.txt ./requirements.txt
RUN pip install --upgrade pip wheel && pip wheel --wheel-dir /wheels -r requirements.txt

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN useradd -u 10001 -m appuser
COPY --from=builder /wheels /wheels
COPY hlas/requirements.txt ./requirements.txt
RUN pip install --no-index --find-links=/wheels -r requirements.txt
COPY hlas/src ./src
RUN mkdir -p /var/log/hlas && chown -R appuser:appuser /var/log/hlas
ENV PYTHONPATH=/app/src
USER 10001
EXPOSE 8000
CMD ["uvicorn", "hlas.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]


